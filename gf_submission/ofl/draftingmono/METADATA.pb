name: "Drafting Mono"
designer: "Owen Earl"
license: "OFL"
category: "MONOSPACE"
date_added: "2026-09-14"
source {
  repository_url: "https://github.com/indestructible-type/Drafting"
}
fonts {
  name: "Drafting Mono"
  style: "normal"
  weight: 400
  filename: "DraftingMono[wght].ttf"
  post_script_name: "DraftingMono-Regular"
  full_name: "Drafting Mono Regular"
  copyright: "Copyright 2021 The Drafting Mono Project Authors (https://github.com/indestructible-type/Drafting)"
}
fonts {
  name: "Drafting Mono"
  style: "italic"
  weight: 400
  filename: "DraftingMono-Italic[wght].ttf"
  post_script_name: "DraftingMono-Italic"
  full_name: "Drafting Mono Italic"
  copyright: "Copyright 2021 The Drafting Mono Project Authors (https://github.com/indestructible-type/Drafting)"
}
subsets: "braille"
subsets: "latin"
subsets: "latin-ext"
subsets: "menu"
axes {
  tag: "wght"
  min_value: 100.0
  max_value: 700.0
}
