lookup ss01StyleSet1inLatinlookup0 {
  lookupflag 0;
    sub \b by \b.alt ;
    sub \h by \h.alt ;
} ss01StyleSet1inLatinlookup0;

lookup caltContextualAlternatesinLatinlookup1 {
  lookupflag 0;
    @cc4_match_1 = [\H \J \K \M \N \T \U \V \W \X \Y \d \f ];
    @cc4_match_2 = [\b ];
    @cc4_match_3 = [\h ];
    @cc4_back_1 = [\H \J \K \M \N \T \U \V \W \X \Y \d \f ];
    @cc4_back_2 = [\b ];
    @cc4_back_3 = [\h ];
    @cc4_ahead_1 = [\H \J \K \M \N \T \U \V \W \X \Y \d \f ];
    @cc4_ahead_2 = [\b ];
    @cc4_ahead_3 = [\h ];
    sub @cc4_back_1 @cc4_match_2'lookup ss01StyleSet1inLatinlookup0  ;
    sub @cc4_back_1 @cc4_match_3'lookup ss01StyleSet1inLatinlookup0  ;
} caltContextualAlternatesinLatinlookup1;

feature ss02 {

 script DFLT;
     language dflt ;
      lookup ss02StyleSet2lookup6;

 script grek;
     language dflt ;
      lookup ss02StyleSet2lookup6;

 script latn;
     language dflt ;
      lookup ss02StyleSet2lookup6;
} ss02;

feature smcp {

 script latn;
     language dflt ;
      lookup smcpLowercasetoSmallCapitalsinLatinlookup0;
} smcp;

feature c2sc {

 script latn;
     language dflt ;
      lookup c2scCapitalstoSmallCapitalsinLatinlookup0;
} c2sc;

feature ss01 {

 script DFLT;
     language dflt ;
      lookup ss01StyleSet1inLatinlookup0;

 script latn;
     language dflt ;
      lookup ss01StyleSet1inLatinlookup0;
} ss01;

feature calt {

 script DFLT;
     language dflt ;
      lookup caltContextualAlternatesinLatinlookup1;

 script latn;
     language dflt ;
      lookup caltContextualAlternatesinLatinlookup1;
} calt;
#Mark attachment classes (defined in GDEF, used in lookupflags)

